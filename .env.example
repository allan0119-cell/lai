# --- 伺服器 ---
PORT=3000
NODE_ENV=production

# --- Airtable (絕對不要外流) ---
AIRTABLE_PAT=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AIRTABLE_API_KEY is also supported for compatibility with older setup notes.
# AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# --- JWT (請改為長隨機字串) ---
JWT_SECRET=please_change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=12h

# --- 管理員 (用 npm run hash 你的密碼 產生 hash) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$replaceThisWithBcryptHashOfYourPassword
# For simple deployments you may use ADMIN_PASSWORD instead of ADMIN_PASSWORD_HASH.
# ADMIN_PASSWORD=change-me-before-deploy

# --- AI 智慧功能 (選填,沒填會自動降級為關鍵字比對) ---
ANTHROPIC_API_KEY=

# --- Email 寄送 (選填) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=愛德人才平台 <noreply@example.org>

# --- 自我更新連結密鑰 (用於產生教友自己編輯自己的一次性 token) ---
SELF_UPDATE_SECRET=another_long_random_string_for_signing_self_update_links
